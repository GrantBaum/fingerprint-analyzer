# Build output
build/
*.o
*.out

# Program output (debug images, regenerated every run)
out/

# Test fingerprint images: too big for git, and the datasets have their own licenses
data/

# Database contents are generated by the program, so ignore everything in db/
# but keep the empty raw/ skel/ tmpl/ folders via their .gitkeep files
db/*
!db/raw/
!db/skel/
!db/tmpl/
db/raw/*
db/skel/*
db/tmpl/*
!db/raw/.gitkeep
!db/skel/.gitkeep
!db/tmpl/.gitkeep

# Download leftovers
wget-log*

# CMake leftovers, if you ever build with CMake again
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# Editors and OS junk
.vscode/
.idea/
*.swp
.DS_Store
*:Zone.Identifier